{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vscode"]
  },
  "include": [
    "src/**/*.ts",
    "../src/embed/sharedWithHost.ts",
    "../src/embed/embedProtocol.ts",
    "../src/embed/sketchDocument.ts"
  ]
}
