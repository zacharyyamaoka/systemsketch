{
  "name": "systemsketch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4322 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:context-menu": "node tests/block_context_menu_smoke.mjs",
    "test:click-to-edit": "node tests/block_click_to_edit_smoke.mjs",
    "test:fields": "node tests/inspector_live_commit_smoke.mjs",
    "test:batch": "node tests/block_batch_editing_smoke.mjs",
    "test:ports": "node tests/block_port_in_window_smoke.mjs",
    "test:rows": "node tests/block_port_rows_smoke.mjs",
    "test:release-ui": "node tests/release_channel_controls_smoke.mjs",
    "test:selection-menu": "node tests/selection_menu_smoke.mjs",
    "test:appearance": "node tests/appearance_menu_smoke.mjs",
    "test:arrows": "node tests/arrow_drawing_smoke.mjs",
    "test:edges": "node tests/block_edges_acceptance.mjs",
    "test:edge-editor": "node tests/block_edge_editor_smoke.mjs",
    "test:scale": "node tests/interface_scale_anchoring_smoke.mjs",
    "test:reveal": "node tests/edge_reveal_area_smoke.mjs",
    "test:polarity": "node tests/edge_polarity_smoke.mjs",
    "test:visibility": "node tests/block_collapse_visibility_smoke.mjs",
    "test:workspace": "node tests/workspace_browser_smoke.mjs",
    "test:windows": "node tests/desktop_windows_smoke.mjs",
    "test:arrow-sync": "node tests/edge_arrow_sync_smoke.mjs",
    "test:pill": "node tests/literal_pill_smoke.mjs",
    "test:recorder": "node tests/recorder_smoke.mjs",
    "plugin:build": "npm --prefix vscode-systemsketch run build",
    "plugin:package": "npm --prefix vscode-systemsketch run package",
    "plugin:test": "npm --prefix vscode-systemsketch test",
    "obsidian:build": "npm --prefix obsidian-systemsketch run build",
    "obsidian:test": "npm --prefix obsidian-systemsketch test",
    "check": "tsc -b && vitest run && python3 -m unittest discover -s tests -v",
    "release:candidate": "python3 scripts/release.py candidate",
    "release:promote": "python3 scripts/release.py promote",
    "release:rollback": "python3 scripts/release.py rollback",
    "release:status": "python3 scripts/release.py status",
    "desktop:install": "python3 scripts/install_desktop.py",
    "desktop:start": "python3 scripts/launch_systemsketch.py --no-open",
    "desktop:preview": "python3 scripts/launch_systemsketch.py --preview --no-open",
    "desktop:status": "python3 scripts/launch_systemsketch.py --status",
    "desktop:stop": "python3 scripts/launch_systemsketch.py --stop --all",
    "test:file-type": "node tests/systemsketch_file_type_smoke.mjs",
    "test:case-view": "node tests/branch_case_view_smoke.mjs",
    "test:authoring": "node tests/branch_authoring_smoke.mjs",
    "test:branch": "node tests/branch_region_smoke.mjs",
    "test:edge-vocabulary": "node tests/edge_vocabulary_smoke.mjs",
    "test:file-type-stable": "node tests/stable_file_type_probe.mjs",
    "test:detach": "node tests/block_detach_smoke.mjs",
    "test:selectable": "node tests/block_footer_drag_smoke.mjs",
    "test:embed-lifecycle": "node tests/embed_lifecycle_smoke.mjs",
    "test:portable": "node tests/portable_tldraw_export_smoke.mjs",
    "test:repo-ui": "node tests/library_overview_smoke.mjs",
    "test:review": "node tests/review_gallery_smoke.mjs",
    "test:workspace-safety": "node tests/workspace_safety_smoke.mjs",
    "test:comments": "node tests/local_comments_smoke.mjs",
    "test:commands": "node tests/command_palette_smoke.mjs",
    "test:diagnostics": "node tests/board_diagnostics_smoke.mjs",
    "test:workspace-followup": "node tests/workspace_followup_smoke.mjs",
    "test:followup-review": "node tests/followup_review_gallery_smoke.mjs",
    "test:detach-fidelity": "node tests/detach_fidelity_smoke.mjs",
    "test:detached-port-row": "node tests/detached_port_row_smoke.mjs",
    "test:worktree-paths": "node tests/development_worktree_paths_smoke.mjs",
    "test:theme": "node --experimental-strip-types tests/theme_contrast_smoke.mjs",
    "test:zoom-controls": "node tests/zoom_controls_preference_smoke.mjs",
    "test:layout-commands": "node tests/layout_commands_smoke.mjs",
    "theme:import": "node --experimental-strip-types scripts/import_vscode_theme.mjs",
    "theme:obsidian": "python3 scripts/extract_obsidian_palette.py",
    "test:export": "node tests/tldraw_export_smoke.mjs"
  },
  "dependencies": {
    "elkjs": "0.12.0",
    "lucide-react": "1.33.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldraw": "5.3.2"
  },
  "devDependencies": {
    "@tldraw/assets": "5.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
