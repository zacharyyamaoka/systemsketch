  "callouts": [
    {
      "id": "step-1",
      "kind": "step",
      "text": "1 · Click the violet Async region frame. Its communication bar opens above the board.",
      "x": 100,
      "y": 300,
      "w": 420,
      "h": 120,
      "target": { "shapeId": "region", "anchor": "left", "dy": -260 }
    },
    {
      "id": "step-2",
      "kind": "step",
      "text": "2 · In that bar press Components, then press Service in the DRAW group.",
      "x": 100,
      "y": 470,
      "w": 420,
      "h": 110,
      "target": { "shapeId": "region", "anchor": "left", "dy": -100 }
    },
    {
      "id": "step-3",
      "kind": "step",
      "text": "3 · Drag from anywhere on Mission's card onto Robot's card. No ports, no port dots — surface to surface. The arrowhead names the client.",
      "x": 100,
      "y": 630,
      "w": 420,
      "h": 150,
      "target": { "shapeId": "mission", "anchor": "left" }
    },
    {
      "id": "step-4",
      "kind": "step",
      "text": "4 · Press Action, drag Mission → Robot again. Then press Stream and drag Camera → Mission.",
      "x": 1800,
      "y": 340,
      "w": 420,
      "h": 130,
      "target": { "shapeId": "robot", "anchor": "right", "dy": -60 }
    },
    {
      "id": "step-5",
      "kind": "step",
      "text": "5 · Press Dataflow. The ports and cables the three arrows generated are now on the cards.",
      "x": 1800,
      "y": 530,
      "w": 420,
      "h": 130,
      "target": { "shapeId": "robot", "anchor": "right", "dy": 60 }
    },
    {
      "id": "step-6",
      "kind": "step",
      "text": "6 · Back in Components, click the A1 arrow, type a new name in the bar's Name field and press Rename.",
      "x": 1800,
      "y": 900,
      "w": 420,
      "h": 140,
      "target": { "shapeId": "camera", "anchor": "right" }
    },
    {
      "id": "pass",
      "kind": "pass",
      "text": "PASS WHEN Components shows exactly three arrows — S1 · service · robot, A1 · action · robot, ST1 · stream · camera — and Dataflow shows the ports that spell them: robot.request/response, robot.goal/feedback/result, camera.stream. Camera's stream socket sits on its TOP edge with the label below it, because Mission is above it.",
      "x": 620,
      "y": 1290,
      "w": 1080,
      "h": 220
    }
  ]
