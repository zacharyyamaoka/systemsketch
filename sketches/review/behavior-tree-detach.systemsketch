      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 560,
        "h": 230,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Right-click any leaf card in this row — MoveToObj, CloseGrip, MoveHome. There must be NO \"Detach to primitives\" item: a projected occurrence belongs to the XML, not to you. Press Escape; nothing may disappear."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a2dzJ",
      "typeName": "shape"
    },
    {
      "x": 60,
      "y": 1080,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 700,
        "h": 230,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Step 1 offers no Detach item and removes nothing; step 2 replaces the region with a stock frame full of stock shapes without crashing; step 4 restores the region and its whole tree in one undo."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a6rUa",
      "typeName": "shape"
    },
