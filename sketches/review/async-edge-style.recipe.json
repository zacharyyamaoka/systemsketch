{
  "feature": "Async edge type · V1 packet cadence",
  "viewport": { "width": 1900, "height": 1200 },
  "shapes": [
    {
      "id": "short-source", "type": "block", "x": 650, "y": 300,
      "props": {
        "title": "emit_short()", "blockType": "call", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "clock", "type": "Tick", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "packet", "type": "Packet", "visible": true }]
      }
    },
    {
      "id": "short-sink", "type": "block", "x": 1030, "y": 300,
      "props": {
        "title": "receive_short()", "blockType": "call", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "packet", "type": "Packet", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "ack", "type": "Ack", "visible": true }]
      }
    },
    {
      "id": "west-top", "type": "block", "x": 220, "y": 540,
      "props": {
        "title": "camera_bus()", "blockType": "source", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "sync", "type": "Clock", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "frames", "type": "Frame", "visible": true }]
      }
    },
    {
      "id": "west-bottom", "type": "block", "x": 220, "y": 800,
      "props": {
        "title": "telemetry()", "blockType": "source", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "poll", "type": "Tick", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "events", "type": "Event", "visible": true }]
      }
    },
    {
      "id": "hub-top", "type": "block", "x": 800, "y": 540,
      "props": {
        "title": "broker()", "blockType": "queue", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "messages", "type": "Message", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "batch", "type": "Batch", "visible": true }]
      }
    },
    {
      "id": "hub-bottom", "type": "block", "x": 800, "y": 800,
      "props": {
        "title": "archive()", "blockType": "sink", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "records", "type": "Record", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "receipt", "type": "Ack", "visible": true }]
      }
    },
    {
      "id": "east-top", "type": "block", "x": 1400, "y": 540,
      "props": {
        "title": "render()", "blockType": "worker", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "frames", "type": "Frame", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "events", "type": "Event", "visible": true }]
      }
    },
    {
      "id": "east-bottom", "type": "block", "x": 1400, "y": 800,
      "props": {
        "title": "persist()", "blockType": "worker", "view": "port", "w": 250, "h": 150,
        "inputs": [{ "id": "in_1", "name": "events", "type": "Event", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "status", "type": "Status", "visible": true }]
      }
    },

    { "id": "candidate", "type": "connection", "x": 0, "y": 0, "props": { "routing": "straight", "temporal": "data" } },
    { "id": "async-cross-a", "type": "connection", "x": 0, "y": 0, "props": { "routing": "straight", "temporal": "async" } },
    { "id": "async-cross-b", "type": "connection", "x": 0, "y": 0, "props": { "routing": "straight", "temporal": "async" } },
    { "id": "async-east", "type": "connection", "x": 0, "y": 0, "props": { "routing": "elbow", "temporal": "async" } },
    { "id": "async-return", "type": "connection", "x": 0, "y": 0, "props": { "routing": "curved", "temporal": "async" } },
    { "id": "data-top", "type": "connection", "x": 0, "y": 0, "props": { "routing": "elbow", "temporal": "data" } },
    { "id": "data-bottom", "type": "connection", "x": 0, "y": 0, "props": { "routing": "elbow", "temporal": "data" } },
    { "id": "data-middle", "type": "connection", "x": 0, "y": 0, "props": { "routing": "curved", "temporal": "data" } }
  ],
  "bindings": [
