    { "id": "candidate-end", "type": "connection", "fromId": "candidate", "toId": "short-sink", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } },

    { "id": "async-a-start", "type": "connection", "fromId": "async-cross-a", "toId": "west-top", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "async-a-end", "type": "connection", "fromId": "async-cross-a", "toId": "east-bottom", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } },
    { "id": "async-b-start", "type": "connection", "fromId": "async-cross-b", "toId": "west-bottom", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "async-b-end", "type": "connection", "fromId": "async-cross-b", "toId": "east-top", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } },
    { "id": "async-east-start", "type": "connection", "fromId": "async-east", "toId": "hub-top", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "async-east-end", "type": "connection", "fromId": "async-east", "toId": "east-top", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } },
    { "id": "async-return-start", "type": "connection", "fromId": "async-return", "toId": "east-top", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "async-return-end", "type": "connection", "fromId": "async-return", "toId": "hub-bottom", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } },

    { "id": "data-top-start", "type": "connection", "fromId": "data-top", "toId": "west-top", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "data-top-end", "type": "connection", "fromId": "data-top", "toId": "east-top", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } },
    { "id": "data-bottom-start", "type": "connection", "fromId": "data-bottom", "toId": "west-bottom", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "data-bottom-end", "type": "connection", "fromId": "data-bottom", "toId": "east-bottom", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } },
    { "id": "data-middle-start", "type": "connection", "fromId": "data-middle", "toId": "hub-top", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "data-middle-end", "type": "connection", "fromId": "data-middle", "toId": "hub-bottom", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } }
  ],
  "callouts": [
    {
      "id": "note", "kind": "note",
      "text": "Four async cables and three solid data cables are pre-seeded below: long runs, crossings, elbows, curves, and a right-to-left return.",
      "x": 70, "y": 60, "w": 460, "h": 150
    },
    {
      "id": "step-1", "kind": "step",
      "text": "1 · Click the short solid cable between emit_short() and receive_short(). In the inspector choose Edge type → Async.",
      "x": 640, "y": 60, "w": 620, "h": 150,
      "target": { "shapeId": "short-source", "anchor": "top", "dx": 105 }
    },
    {
      "id": "step-2", "kind": "step",
      "text": "2 · Right-click any packet-marked cable. Open Edge type and confirm Async is checked; Data and Delayed remain separate choices.",
      "x": 1350, "y": 60, "w": 470, "h": 150,
      "target": { "shapeId": "east-top", "anchor": "top", "dx": -90 }
    },
    {
      "id": "pass", "kind": "pass",
      "text": "PASS WHEN the short target becomes the fifth async cable, its tiny packet gaps remain visible, long/crossing routes stay easy to trace, and the solid data cables still read as a different edge type.",
      "x": 70, "y": 1030, "w": 740, "h": 140
    }
  ]
}
