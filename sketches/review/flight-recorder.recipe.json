{
  "feature": "Flight recorder: explicit start and stop",
  "viewport": { "width": 1400, "height": 820 },
  "shapes": [
    {
      "id": "camera",
      "type": "block",
      "x": 160,
      "y": 330,
      "props": {
        "title": "camera()",
        "blockType": "call",
        "view": "port",
        "w": 300,
        "h": 170,
        "inputs": [],
        "outputs": [{ "id": "out_1", "name": "frame", "type": "Frame", "visible": true }]
      }
    },
    {
      "id": "detector",
      "type": "block",
      "x": 720,
      "y": 330,
      "props": {
        "title": "detector()",
        "blockType": "call",
        "view": "port",
        "w": 300,
        "h": 170,
        "inputs": [{ "id": "in_1", "name": "frame", "type": "Frame", "visible": true }],
        "outputs": [{ "id": "out_1", "name": "boxes", "type": "Boxes", "visible": true }]
      }
    },
    {
      "id": "cable",
      "type": "connection",
      "x": 0,
      "y": 0,
      "props": {
        "start": { "x": 0, "y": 0 },
        "end": { "x": 0, "y": 0 },
        "routing": "elbow",
        "curve": null,
        "pins": [],
        "elbowRoute": null,
        "temporal": "data",
        "delayValue": "",
        "pillPosition": 0.5
      }
    }
  ],
  "bindings": [
    { "id": "b1", "type": "connection", "fromId": "cable", "toId": "camera", "props": { "portId": "out_1", "terminal": "start", "face": "outer" } },
    { "id": "b2", "type": "connection", "fromId": "cable", "toId": "detector", "props": { "portId": "in_1", "terminal": "end", "face": "outer" } }
  ],
  "callouts": [
    {
      "id": "step-1",
      "kind": "step",
      "text": "1 · Click </> in the bottom-right. Under RECORDING, click the broad Start recording face. The red REC notice should replace Preview without covering either top capsule.",
      "x": 720,
      "y": 600,
      "w": 520,
      "h": 150,
      "target": { "shapeId": "detector", "anchor": "bottom" }
    },
    {
      "id": "step-2",
      "kind": "step",
      "text": "2 · Close Dev, then reproduce the bug: drag detector() down about 150 px and press Escape. Reopen Dev or use the red notice; click Stop and save before one minute.",
      "x": 760,
      "y": 80,
      "w": 520,
      "h": 150
    },
    {
      "id": "step-3",
      "kind": "step",
      "text": "3 · Paste into an agent chat. The chevron at rest contains only Copy last recording plus the note that one minute cancels without saving.",
      "x": 160,
      "y": 80,
      "w": 520,
      "h": 135
    },
    {
      "id": "pass",
      "kind": "pass",
      "text": "PASS WHEN · Start is the only primary action; Stop saves and copies a packet beginning “SystemSketch interaction recording”; Preview and REC never overlap the top chrome.",
      "x": 160,
      "y": 600,
      "w": 480,
      "h": 160
    }
  ]
}
