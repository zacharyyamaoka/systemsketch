            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    pose = merge(pose, other)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    trail.append(score(pose))"
                }
              ]
