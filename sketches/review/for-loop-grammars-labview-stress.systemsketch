    {
      "x": 2226,
      "y": 918,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:s1v2-code",
      "type": "text",
      "props": {
        "color": "grey",
        "size": "s",
        "w": 8,
        "font": "mono",
        "textAlign": "start",
        "autoSize": true,
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "pose = estimate(frame, gain)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "trail = []"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "for other in others:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    pose = merge(pose, other)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    trail.append(score(pose))"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "b2ftkZ2G",
      "typeName": "shape"
