    {
      "x": -520,
      "y": 60,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 180,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Columns are the three finalists (V4, V2, V1); rows are the five stress loops. Every card carries real Blocks and real cables."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "b2k0D2",
      "typeName": "shape"
    },
    {
      "x": 26,
      "y": 1778,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:s2v4-code",
      "type": "text",
      "props": {
        "color": "grey",
        "size": "s",
        "w": 8,
        "font": "mono",
        "textAlign": "start",
        "autoSize": true,
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "best = None"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "for i, (name, box) in enumerate(zip(names, boxes)):"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    score = rate(box, gain)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    best = pick(best, score, name, i)"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "b2fx7jZG",
      "typeName": "shape"
    },
    {
      "x": 2226,
      "y": 3498,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:s4v2-code",
      "type": "text",
      "props": {
        "color": "grey",
        "size": "s",
        "w": 8,
        "font": "mono",
        "textAlign": "start",
        "autoSize": true,
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "misses = 0"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "for track in tracks:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    for det in track.dets:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "        if match(det, query):"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "            hit = det"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "            break"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    else:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "        misses = misses + 1"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "b2gfrVL",
      "typeName": "shape"
    },
