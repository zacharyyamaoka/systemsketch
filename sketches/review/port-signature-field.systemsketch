        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Select estimate. In the inspector, the Inputs row is ONE field: frame: Frame. Click it, select all, type   window: int = 5   — watch the Block paint name, type and the = 5 chip as you type"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a3F0j",
      "typeName": "shape"
    },
    {
      "x": 40,
      "y": 620,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 470,
        "h": 200,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · There is one text field per port everywhere (inspector row, canvas editor, free Port panel); a colon offers Types, an equals sign offers variables, a bare name offers nothing; and the Block always paints what the line says."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a66IE",
      "typeName": "shape"
    },
    {
      "x": 1180,
      "y": 300,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 380,
        "h": 200,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · In that same field type   pose: P   — the moment you pass the colon, the board's Types appear (Pose is the Type Block on the left). Enter accepts it."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4O3z",
      "typeName": "shape"
    },
    {
