        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3 · On the canvas, click the input's name (or its type) — the same one-line editor opens over the port. Press End, type   = None   and Enter. Then type two plain words in it: no suggestions, just a name."
                }
              ]
            }
          ]
        }
      },
