      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 660,
        "h": 150,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 2,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
