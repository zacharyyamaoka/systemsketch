        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · The original region never scrambles. Every card stays where it is through the duplicate, the drag and the undo — and you never have to press Tidy to repair it."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a6koA",
      "typeName": "shape"
    },
