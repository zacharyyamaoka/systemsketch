        "w": 1514,
        "h": 712,
        "title": "PickAndPlace",
        "xml": "<root BTCPP_format=\"4\" main_tree_to_execute=\"PickAndPlace\">\n  <BehaviorTree ID=\"PickAndPlace\">\n    <Sequence name=\"Pick and place\">\n      <SubTree ID=\"MoveToObj\" target=\"{obj}\"/>\n      <Fallback name=\"Grasp or correct\">\n        <GraspValid grasp=\"{grasp}\"/>\n        <CorrectGrip grasp=\"{grasp}\"/>\n      </Fallback>\n      <CloseGrip effort=\"40\"/>\n      <MoveHome speed=\"0.4\"/>\n    </Sequence>\n  </BehaviorTree>\n  <TreeNodesModel>\n    <Action ID=\"CloseGrip\"><input_port name=\"effort\" type=\"double\"/></Action>\n    <Action ID=\"MoveHome\"><input_port name=\"speed\" type=\"double\"/></Action>\n    <Condition ID=\"GraspValid\"><input_port name=\"grasp\" type=\"Pose\"/></Condition>\n    <Action ID=\"CorrectGrip\"><input_port name=\"grasp\" type=\"Pose\"/></Action>\n  </TreeNodesModel>\n</root>",
        "treeId": "PickAndPlace",
