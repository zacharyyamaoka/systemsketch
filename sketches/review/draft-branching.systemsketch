    },
    {
      "x": 40,
      "y": 1080,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 1170,
        "h": 190,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Compare opens with NO checkboxes and NO bottom bar · Merge and Rebase each open the same dialog with a per-element tick and one confirm · unticking anything disables the confirm and explains why instead of quietly applying everything · the Rebase review's after-board is the proposed draft, not Main · confirming Merge writes to Main and closes the dialog; a Main that moved underneath refuses IN the dialog and leaves both sides intact"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a8QzUV",
      "typeName": "shape"
    },
    {
      "x": 470,
      "y": 330,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 380,
        "h": 140,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Rename Planner to \"Planner v2\" in the inspector — the bar's Compare count becomes 1"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4orI",
      "typeName": "shape"
    },
    {
      "x": -55.58210582107138,
      "y": -175.3939486416902,
