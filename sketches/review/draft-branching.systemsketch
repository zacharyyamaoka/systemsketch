            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Click Drafts in the top-left shell, then New draft"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a3F9b",
