        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Click \"pose: Pose\" to expand — self-referential, so click the nested \"x: Pose\" again to go as deep as you like. With the block selected, click any row text (not the chevron, not the blue link) — Source mode opens with the cursor AT THE CLICK. A nested row (e.g. \"y: float = 10\") jumps to the block that OWNS it (Pose) and lands the cursor on that field’s line, at your click position."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a9KPb",
      "typeName": "shape"
    },
