        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "0 · PROTOTYPE FLAG — add   &portLanes=1   to this page's URL and reload. Without it the Block keeps today's one-port editor."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a2P5v",
      "typeName": "shape"
    },
    {
      "x": 40,
      "y": 300,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 190,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Select estimate, then click the LEFT half of its body on the frame row. One editor opens over all three inputs — a line per port — with the caret on frame's line."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a3Ir2",
      "typeName": "shape"
    },
    {
      "x": 560,
      "y": 640,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 620,
        "h": 190,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Ports read and edit as lines: reorder with Alt+↑/↓, add with Enter, duplicate with Shift+Alt+↓ — and a moved port keeps its cables, because its id moved with its line."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a6B5X",
      "typeName": "shape"
    },
    {
      "x": 560,
      "y": 40,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 620,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Press Alt+↑ : frame moves above pose and the Block repaints. Press End, Enter, type   yaw: float = 0   — a fourth port appears. Shift+Alt+↓ duplicates it. Ctrl+Enter commits."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4wmn",
      "typeName": "shape"
    },
