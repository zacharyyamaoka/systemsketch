      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 400,
        "h": 190,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 22,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN drags land where dropped with no preview flicker at slot boundaries, the Fallback lands at root level with both children intact, and one Ctrl+Z undoes the whole drag."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a58Tr",
      "typeName": "shape"
    },
    {
      "x": 30,
