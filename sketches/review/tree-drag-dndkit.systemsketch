        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Park the dragged card right on a slot boundary, then wobble it a few pixels — the preview HOLDS its slot instead of flapping back and forth (new deadband)."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
