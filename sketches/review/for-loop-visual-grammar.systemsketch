    },
    {
      "x": 24,
      "y": 34,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:lanes-s5-code",
      "type": "geo",
      "parentId": "shape:lanes-s5",
      "props": {
        "w": 932,
        "h": 128,
        "geo": "rectangle",
        "dash": "solid",
        "growY": 120,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "grey",
        "labelColor": "black",
        "fill": "semi",
        "size": "s",
        "font": "mono",
        "align": "middle",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "best = None"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "for batch in batches:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    score = 0"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    for candidate in batch:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "        score += evaluate(candidate)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "        if score >= threshold: break"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    if score >= threshold:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "        best = candidate; break"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "return best"
                }
              ]
            }
          ]
        }
      },
