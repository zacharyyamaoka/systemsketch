      "id": "shape:paired-s1",
      "type": "frame",
      "props": {
        "w": 980,
        "h": 610,
        "name": "V1 · Paired Gates · 1 · Easy · Pure map · item only",
        "color": "black"
      },
      "parentId": "page:page",
