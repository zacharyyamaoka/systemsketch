              "content": [
                {
                  "type": "text",
                  "text": "        best = candidate; break"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "return best"
                }
              ]
            }
          ]
        }
