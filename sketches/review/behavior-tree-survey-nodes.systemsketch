        "title": "Patrol",
        "xml": "<root BTCPP_format=\"4\" main_tree_to_execute=\"Patrol\">\n    <BehaviorTree ID=\"Patrol\">\n        <AsyncSequence name=\"Patrol\">\n            <Breakpoint>\n                <DetectTarget target=\"{target_pose}\"/>\n            </Breakpoint>\n            <AsyncFallback name=\"Approach or search\" _disabled=\"true\">\n                <ApproachTarget pose=\"{target_pose}\"/>\n                <SearchArea/>\n                <Parallel>\n                    <IfThenElse/>\n                </Parallel>\n            </AsyncFallback>\n            <Sequence name=\"Group\">\n                <PickUp pose=\"{target_pose}\"/>\n                <Stow/>\n                <ReturnHome/>\n            </Sequence>\n        </AsyncSequence>\n    </BehaviorTree>\n    <TreeNodesModel>\n        <Condition ID=\"DetectTarget\">\n            <output_port name=\"target\" type=\"Pose\"/>\n        </Condition>\n        <Action ID=\"ApproachTarget\">\n            <input_port name=\"pose\" type=\"Pose\"/>\n        </Action>\n        <Action ID=\"SearchArea\"/>\n        <Action ID=\"PickUp\">\n            <input_port name=\"pose\" type=\"Pose\"/>\n        </Action>\n        <Action ID=\"Stow\"/>\n        <Action ID=\"ReturnHome\"/>\n    </TreeNodesModel>\n</root>\n",
