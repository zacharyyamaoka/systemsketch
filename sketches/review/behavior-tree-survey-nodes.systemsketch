          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Ctrl+G yields one \"Group\" Sequence and one Ctrl+Z removes it; Comment in/out toggles the dim and the _disabled attribute in Source; the Breakpoint card wears the filled-dot glyph"
                }
              ]
            }
          ]
        }
      },
