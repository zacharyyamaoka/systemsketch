            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Click the PickUp card, then shift-click Stow and ReturnHome, and press Ctrl+G — the three wrap into one new Sequence named \"Group\" (rename it in the dock)"
                }
              ]
            }
          ]
        }
      },
