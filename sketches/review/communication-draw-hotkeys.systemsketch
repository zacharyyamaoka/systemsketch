        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Click the violet Async region, then press Communication. The DRAW group appears on the bar, and each arrow now carries its own digit."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a2rzN",
      "typeName": "shape"
    },
    {
      "x": 620,
      "y": 980,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 1000,
        "h": 210,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN every DRAW button shows its digit — Stream 1, Service 2, Action 3 — and pressing that digit arms exactly that arrow, with the same press again putting it away. Typing a digit into a name types it. Outside Communication the digits go back to the toolbar."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a6jAn",
      "typeName": "shape"
    },
