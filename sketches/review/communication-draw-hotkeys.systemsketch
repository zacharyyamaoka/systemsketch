            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "4 · Press Dataflow, where there is no DRAW group. Now 1, 2 and 3 pick toolbar tools again — the digits are borrowed, not taken."
                }
              ]
            }
          ]
        }
