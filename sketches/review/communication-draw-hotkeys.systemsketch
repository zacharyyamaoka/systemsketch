            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Press 2. Service arms with no mouse at all — its button lights up and its chip reads 2."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
