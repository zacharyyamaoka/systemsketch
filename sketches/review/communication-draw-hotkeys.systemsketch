        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3 · Drag Mission's card onto Robot's. Then press 3 and drag again for Action. Press 3 once more to put the tool away."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4p8I",
      "typeName": "shape"
    },
    {
      "x": 1700,
