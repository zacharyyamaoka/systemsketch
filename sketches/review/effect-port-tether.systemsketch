      "meta": {},
      "id": "shape:cue-3",
      "type": "geo",
      "props": {
        "w": 380,
        "h": 190,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
