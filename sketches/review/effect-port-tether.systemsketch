        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3 · Crossed on purpose"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "These ports sit in the opposite order to"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "their arguments, so the tethers cross."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "aKHGQ",
      "typeName": "shape"
    },
    {
      "name": "",
      "color": "#F2555A",
      "imageUrl": "",
      "meta": {},
      "id": "user:a5VZNuMHSIr7zMjg64DkY",
      "typeName": "user"
    },
    {
      "x": 100,
      "y": 900,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-4",
      "type": "geo",
      "props": {
        "w": 380,
        "h": 190,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "blue",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "4 · Returns a value AND mutates"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "pop() has a real output on the right and"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "an effect port on top, at once."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "aMOB6",
      "typeName": "shape"
    },
    {
      "x": 560,
      "y": 620,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-5",
      "type": "geo",
      "props": {
        "w": 380,
        "h": 190,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "blue",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "5 · Not clickable, Port view only"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Clicking a tether must do nothing."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Expanded view must show none of them."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "aOBvE",
      "typeName": "shape"
    },
    {
      "x": 1000,
      "y": 620,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 380,
        "h": 230,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Every effect port has one tether to its hook,"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "no tether crosses a name or a type,"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "all right angles, none clickable,"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "and Expanded shows none."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "aQ38n",
      "typeName": "shape"
    },
