      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-4",
      "type": "geo",
      "props": {
        "w": 620,
        "h": 160,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "4 · Press Ctrl+P, type 'clear diff' and run Clear diff marks. Every tint, badge and strike goes; the two ghost rows and the ghost cable are deleted outright."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
