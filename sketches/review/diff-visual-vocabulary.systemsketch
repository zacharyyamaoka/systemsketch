      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 400,
        "h": 160,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Look at the struck-through row: a removed port is drawn IN the row it is missing from, not on a floating note."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
