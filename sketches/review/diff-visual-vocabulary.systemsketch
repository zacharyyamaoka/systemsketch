      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 1360,
        "h": 120,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN the calm pair is indistinguishable from a normal board, every mark sits in its own port row, and no row clips its text."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "aCGs6",
      "typeName": "shape"
    },
    {
      "x": 200,
      "y": 660,
