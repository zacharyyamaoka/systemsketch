        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Reader runs before Writer, so this tick cannot see this tick's x. A solid Writer.x → Reader.x would be a causality cycle. Pre stores the write and re-emits it on the next start. Wires around Pre are ordinary this-tick data; z⁻¹ lives in the Block."
                }
              ]
            }
          ]
        }
      },
      "index": "aCVIr",
      "typeName": "shape"
