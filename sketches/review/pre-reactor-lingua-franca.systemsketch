              "content": [
                {
                  "type": "text",
                  "text": "Reader sits after Writer in the sequence. x is produced and consumed at the same start tick, same LF tag. Solid data cable. No Pre."
                }
              ]
            }
          ]
        }
      },
      "index": "a8T62",
      "typeName": "shape"
    },
    {
      "x": 420,
