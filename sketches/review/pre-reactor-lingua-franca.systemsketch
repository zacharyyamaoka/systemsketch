              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "tick t: start → Pre emits x[t-1] (absent on the first tick) → Reader → Writer writes 42 → Pre stores 42."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "tick t+1: start → Pre emits 42 → Reader prints 42. Forward writers on the same tick still override this stored value."
                }
              ]
            }
          ]
        }
