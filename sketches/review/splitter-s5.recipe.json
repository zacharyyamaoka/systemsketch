    {
      "id": "step-1",
      "kind": "step",
      "text": "1 \u00b7 The splitter is a definition in the library, so it carries every field the type declares. Count the unwired rows.",
      "x": 470,
      "y": 120,
      "w": 520,
      "h": 106,
      "target": {
        "shapeId": "split",
        "anchor": "top"
      }
    },
    {
      "id": "note-src",
      "kind": "note",
      "text": "golden 33 \u00b7 shape = self.shape \u00b7 size_m = self.size_m\nObjectSpec(name=self.object_id, type_name=self.subcategory, \u2026)\nObjectRecord declares 20 fields. to_object_spec reads 7. Four reach ObjectSpec().",
      "x": 60,
      "y": 720,
      "w": 480,
      "h": 202
    },
    {
      "id": "pass",
      "kind": "pass",
      "text": "PASS WHEN \u00b7 the block is reusable at every call site \u2014 and you see the cost: rows for members this body never reads, frozen at authoring time.",
      "x": 990,
      "y": 720,
      "w": 510,
      "h": 130
    }
