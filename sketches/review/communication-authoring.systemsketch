    },
    {
      "x": 1800,
      "y": 860,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-6",
      "type": "geo",
      "props": {
        "w": 420,
        "h": 210,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 32,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "6 · Click the label pill on the Service arrow — the pill, not the line. It focuses that relationship even where the Action arrow is painted over it, and its other legs appear. The two pills never overlap and never slide under a card."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a7ibj",
      "typeName": "shape"
