        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Click the violet Async region. Press Components — the cards go Simple and the DRAW group appears."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a276M",
      "typeName": "shape"
    },
    {
