    {
      "x": 620,
      "y": 1290,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 1080,
        "h": 220,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN Components shows exactly three arrows — S1 · service · robot, A1 · action · robot, ST1 · stream · camera — and Dataflow shows the ports that spell them: robot.request/response, robot.goal/feedback/result, camera.stream. Camera's stream socket sits on its TOP edge with the label below it, because Mission is above it."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a85wQ",
      "typeName": "shape"
    },
    {
      "x": 100,
      "y": 470,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 420,
        "h": 110,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · In that bar press Components, then press Service in the DRAW group."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a3TDX",
      "typeName": "shape"
    },
    {
      "x": -18.851674641148335,
      "y": -175.93301435406704,
      "z": 0.7886792452830188,
      "meta": {},
      "id": "camera:page:page",
      "typeName": "camera"
    },
    {
      "x": 100,
      "y": 630,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-3",
      "type": "geo",
      "props": {
        "w": 420,
        "h": 150,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 2,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3 · Drag from anywhere on Mission's card onto Robot's card. No ports, no port dots — surface to surface. The arrowhead names the client."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4Hqz",
      "typeName": "shape"
    },
    {
      "x": 1800,
      "y": 340,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-4",
      "type": "geo",
      "props": {
        "w": 420,
        "h": 130,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
