{
  "feature": "Edge tunnel",
  "viewport": { "width": 1600, "height": 900 },
  "pages": [{ "id": "review", "name": "Edge tunnel review" }],
  "shapes": [
    {
      "id": "decode",
      "type": "block",
      "x": 460,
      "y": 360,
      "props": {
        "title": "decode()",
        "description": "Turns raw bytes into one Frame.",
        "blockType": "Function",
        "view": "port",
        "w": 340,
        "h": 220,
        "inputs": [{ "id": "in_raw", "name": "raw", "type": "bytes", "visible": true }],
        "outputs": [
          { "id": "out_frame", "name": "frame", "type": "Frame", "visible": true },
          { "id": "out_trace", "name": "trace", "type": "Trace", "visible": true, "row": 2 }
        ]
      }
    },
    {
      "id": "estimate",
      "type": "block",
      "x": 1000,
      "y": 360,
      "props": {
        "title": "estimate()",
        "description": "Estimates a Pose from a Frame.",
        "blockType": "Function",
        "view": "port",
        "w": 340,
        "h": 220,
        "inputs": [
          { "id": "in_frame", "name": "frame", "type": "Frame", "visible": true },
          { "id": "in_trace", "name": "trace", "type": "Trace", "visible": true, "row": 2 }
        ],
        "outputs": [{ "id": "out_pose", "name": "pose", "type": "Pose", "visible": true }]
      }
    },
    {
      "id": "tunnel",
      "type": "connection",
      "x": 0,
      "y": 0,
      "props": {
        "start": { "x": 0, "y": 0 },
        "end": { "x": 100, "y": 0 },
        "routing": "elbow",
        "curve": null,
        "pins": [],
        "elbowRoute": null,
        "routeMode": "automatic",
        "temporal": "data",
        "delayValue": "",
        "pillPosition": 0.5,
        "tunnel": true,
        "tunnelLayer": "Diagnostics"
      }
    },
    {
      "id": "other",
      "type": "connection",
      "x": 0,
      "y": 0,
      "props": {
        "start": { "x": 0, "y": 0 },
        "end": { "x": 100, "y": 0 },
        "routing": "elbow",
        "curve": null,
        "pins": [],
        "elbowRoute": null,
        "routeMode": "automatic",
        "temporal": "data",
        "delayValue": "",
        "pillPosition": 0.5,
        "tunnel": false,
        "tunnelLayer": ""
      }
    }
  ],
  "bindings": [
    {
      "id": "tunnel-start",
      "type": "connection",
      "fromId": "tunnel",
      "toId": "decode",
      "props": { "terminal": "start", "portId": "out_frame", "face": "outer" }
    },
    {
      "id": "tunnel-end",
      "type": "connection",
      "fromId": "tunnel",
      "toId": "estimate",
      "props": { "terminal": "end", "portId": "in_frame", "face": "outer" }
    },
    {
      "id": "other-start",
      "type": "connection",
      "fromId": "other",
      "toId": "decode",
      "props": { "terminal": "start", "portId": "out_trace", "face": "outer" }
    },
    {
      "id": "other-end",
      "type": "connection",
      "fromId": "other",
      "toId": "estimate",
      "props": { "terminal": "end", "portId": "in_trace", "face": "outer" }
    }
  ],
  "callouts": [
    {
      "id": "hover-run",
      "kind": "step",
      "text": "1 · Hover the empty run: the cable returns but both mouths stay.",
      "x": 680,
      "y": 120,
      "w": 430,
      "h": 110,
      "target": { "x": 895, "y": 430 }
    },
    {
      "id": "layer",
      "kind": "step",
      "text": "2 · Click Diagnostics: its mouths leave and the other edge tunnels.",
      "x": 1160,
      "y": 120,
      "w": 380,
      "h": 110,
      "target": { "shapeId": "estimate", "anchor": "top", "dx": 0 }
    },
    {
      "id": "pass",
      "kind": "pass",
      "text": "PASS WHEN hover shows the whole Diagnostics cable with both mouths, then layer focus removes its mouths and tunnels the other cable.",
      "x": 500,
      "y": 690,
      "w": 700,
      "h": 120
    }
  ]
}
