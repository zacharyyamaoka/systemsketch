                  "type": "text",
                  "text": "11 · No in-app control exists yet for this preference. Open devtools (F12) console and paste this, then reload the page, to try each variant:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "localStorage.setItem('systemsketch.diff-presentation.v1', JSON.stringify({variant:'stacked', blend:1}))"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Swap 'stacked' for was-now, token-only, delta-badge, ghost-weight, or blend, and reload after each edit."
                }
              ]
            }
          ]
