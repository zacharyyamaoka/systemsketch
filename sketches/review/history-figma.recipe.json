{
  "feature": "Figma-style history review",
  "viewport": { "width": 1700, "height": 1120 },
  "pages": [{ "id": "review", "name": "History review" }],
  "shapes": [
    {
      "id": "load",
      "type": "block",
      "x": 260,
      "y": 360,
      "props": {
        "title": "load_frames",
        "description": "Read a clip off disk",
        "blockType": "Function",
        "view": "port",
        "w": 300,
        "h": 170,
        "inputs": [],
        "outputs": [{ "id": "out_frames", "name": "frames", "type": "bytes", "visible": true }]
      }
    },
    {
      "id": "predict",
      "type": "block",
      "x": 740,
      "y": 360,
      "props": {
        "title": "run_predict",
        "description": "Detect objects per frame",
        "blockType": "Function",
        "view": "port",
        "w": 340,
        "h": 198,
        "inputs": [
          { "id": "in_frames", "name": "frames", "type": "bytes", "visible": true },
          { "id": "in_threshold", "name": "threshold", "type": "float", "visible": true, "defaultValue": "0.5" }
        ],
        "outputs": [{ "id": "out_boxes", "name": "boxes", "type": "Detections", "visible": true }]
      }
    },
    {
      "id": "overlay",
      "type": "block",
      "x": 1180,
      "y": 360,
      "props": {
        "title": "draw_overlay",
        "description": "Paint boxes onto the frame",
        "blockType": "Function",
        "view": "port",
        "w": 320,
        "h": 198,
        "inputs": [{ "id": "in_boxes", "name": "boxes", "type": "Detections", "visible": true }],
        "outputs": [{ "id": "out_image", "name": "image", "type": "RGBA", "visible": true }]
      }
    },
    {
      "id": "metrics",
      "type": "block",
      "x": 740,
      "y": 680,
      "props": {
        "title": "log_metrics",
        "description": "Count detections per clip",
        "blockType": "Function",
        "view": "port",
        "w": 340,
        "h": 170,
        "inputs": [{ "id": "in_data", "name": "data", "type": "Any", "visible": true }],
        "outputs": []
      }
    },
    {
      "id": "cable_xm",
      "type": "connection",
      "x": 0,
      "y": 0,
      "props": { "routing": "elbow", "temporal": "data", "routeMode": "automatic", "state": "normal" }
    }
  ],
  "bindings": [
    {
      "id": "cable_xm-start",
      "type": "connection",
      "fromId": "cable_xm",
      "toId": "predict",
      "props": { "portId": "out_boxes", "terminal": "start", "face": "outer" }
    },
    {
      "id": "cable_xm-end",
      "type": "connection",
      "fromId": "cable_xm",
      "toId": "metrics",
      "props": { "portId": "in_data", "terminal": "end", "face": "outer" }
    }
  ],
  "callouts": [
    {
      "id": "step-inspector",
      "kind": "step",
      "text": "1 · Select run_predict, then open the inspector's History tab.",
      "x": 1120,
      "y": 680,
      "w": 420,
      "h": 110,
      "target": { "shapeId": "predict", "anchor": "right" }
    },
    {
      "id": "step-compare",
      "kind": "step",
      "text": "2 · Open Compare from the top-right shell. Pick an older entry and expand its detail.",
      "x": 690,
      "y": 90,
      "w": 470,
      "h": 110,
      "target": { "shapeId": "predict", "anchor": "top" }
    },
    {
      "id": "step-dock",
      "kind": "step",
      "text": "3 · Use the icon beside Properties / Code to try the bottom dock, then return it right.",
      "x": 690,
      "y": 960,
      "w": 470,
      "h": 110,
      "target": { "shapeId": "metrics", "anchor": "bottom" }
    },
    {
      "id": "pass",
      "kind": "pass",
      "text": "PASS WHEN · The board and Block use the same Figma-style history language, with real file times and no invented author.",
      "x": 1220,
      "y": 850,
      "w": 430,
      "h": 150
    }
  ]
}
