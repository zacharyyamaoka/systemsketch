    {
      "x": 40,
      "y": 180,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 150,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Click this Block. The dock opens by itself. Close it with the × in its header."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4IXf",
      "typeName": "shape"
    },
    {
      "x": 1520,
      "y": 620,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 200,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Selecting anything opens the right panel for it, the dock always has a visible ×, closing it survives the next selection until you deselect, the tab switch reads with one mark, and the Z badge opens Settings."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a9Ds2",
      "typeName": "shape"
    },
    {
      "x": 1520,
      "y": 180,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Now click this Block. The dock must STAY closed — a close used to be undone by the very next selection. Click empty canvas, then a Block again: it returns."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a5fF6",
      "typeName": "shape"
    },
    {
      "x": -58.18182373046875,
      "y": 60.90911865234375,
      "z": 1,
      "meta": {},
      "id": "camera:page:page",
      "typeName": "camera"
    },
    {
      "x": 40,
      "y": 380,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-3",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3 · Click this plain rectangle. The dock should arrive on its own, name it \"Rectangle\" and list Position, Size and its stock styles — and the pill above it carries no Inspect button any more."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a6fwX",
      "typeName": "shape"
    },
    {
      "x": 40,
      "y": 600,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-4",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 42,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "blue",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "4 · Press Ctrl+P, then Tab. The Commands chip alone should say which tab is on — no focus ring competing with it — and ArrowRight must move to Find. The results scrollbar should be thin and themed."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a7Yeb",
      "typeName": "shape"
    },
    {
      "x": 1520,
      "y": 400,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-5",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "blue",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "5 · Click the round Z badge, top right. It used to be titled \"Profile placeholder\" and do nothing; it should now open Settings on the theme panel, whose list answers the arrow keys."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a8mg2",
      "typeName": "shape"
    },
