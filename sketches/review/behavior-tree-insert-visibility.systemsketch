      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 400,
        "h": 220,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · At rest, pointer away — count the blue “+” icons. Before tonight's fix, every Failure hand-off and CorrectGrip terminus had one, all visible at once."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a3zA5",
      "typeName": "shape"
    },
    {
      "x": 40,
      "y": 40,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 400,
        "h": 260,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Exactly one blue “+” shows with the pointer off the board — the true end-of-tree terminus at the bottom. Every Failure/CorrectGrip/convergence “+”, at all 3 levels, stays hidden until hovered. Tree view still renders the same chain cleanly."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a27dX",
      "typeName": "shape"
    },
    {
      "x": 40,
      "y": 680,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 400,
        "h": 220,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 22,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · This chain nests 3 levels: GraspValid fails into a Fallback, whose own CorrectGrip fails into ANOTHER Fallback, down to PlanPath. Built live via “Add failure recovery”, twice — not hand-written XML."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4Xxf",
      "typeName": "shape"
    },
    {
      "x": 0,
      "y": 0,
