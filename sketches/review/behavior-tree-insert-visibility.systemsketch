    },
    {
      "x": 40,
      "y": 980,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-3",
      "type": "geo",
      "props": {
        "w": 400,
        "h": 220,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3 · Hover near a Failure label or a CorrectGrip's trailing gap — its own “+” fades in on approach, and disappears the moment the pointer leaves. True at every nesting level."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a5aWf",
      "typeName": "shape"
    },
