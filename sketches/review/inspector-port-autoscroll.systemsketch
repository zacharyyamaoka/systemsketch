        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Holding at the edge scrolls the panel on its own, the tinted drop band keeps following the row under the cursor, and you can release on the HEADER line to move the port there. Before this change the panel never moved, so the HEADER row could not be reached at all."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a5IZf",
      "typeName": "shape"
