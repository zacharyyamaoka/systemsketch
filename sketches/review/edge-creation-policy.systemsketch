    {
      "x": 140,
      "y": 220,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 440,
        "h": 150,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Open the main menu (top left) and choose Settings, then Connections. It opens on Guided, reading 5/9."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a4XZQ",
      "typeName": "shape"
    },
    {
      "x": 140,
      "y": 780,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 440,
        "h": 240,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 2,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN each drag is refused under the tighter preset — no cable appears and nothing else is offered — and the SAME drag draws a cable under Whiteboard. The panel's count must track every change, and read Custom once you flip a single switch by hand."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a8vub",
      "typeName": "shape"
    },
    {
      "x": 1420,
      "y": 210,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 440,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Press Whiteboard (0/9), close Settings, then drag producer's RIGHT dot onto consumer's RIGHT dot. Two outputs. Guided refuses this; Whiteboard draws it."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a5hUs",
      "typeName": "shape"
    },
    {
      "x": -79.91266375545851,
      "y": -72.29257641921402,
      "z": 1.0651162790697675,
      "meta": {},
      "id": "camera:page:page",
      "typeName": "camera"
    },
    {
      "x": 1420,
      "y": 470,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-3",
      "type": "geo",
      "props": {
        "w": 440,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3 · Delete that cable. Back in Settings press Strict (8/9), then drag producer's RIGHT dot onto consumer's LEFT dot — Pose into bytes."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a67Bn",
      "typeName": "shape"
    },
    {
      "x": 1420,
      "y": 810,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-4",
      "type": "geo",
      "props": {
        "w": 440,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "4 · Still on Strict, drag child's RIGHT dot up onto producer's LEFT dot. It reaches past box's wall. Then switch to Whiteboard and repeat it."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a7u4n",
      "typeName": "shape"
