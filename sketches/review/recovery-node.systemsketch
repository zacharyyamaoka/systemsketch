      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 420,
        "h": 170,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 12,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · ComputePathToPose is the PRIMARY step. On FAILURE it enters the recovery arm via this “Failure” chip — same mechanism a Fallback uses"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a2XhM",
      "typeName": "shape"
    },
    {
      "x": 40,
      "y": 980,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 420,
        "h": 260,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · The Retry ×3 wire is dashed, travels backward, and lands on ComputePathToPose's own entry — AND the menu's “Recovery” row reads as its own primitive beside “Fallback”, not a relabel of it"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a60Bz",
      "typeName": "shape"
    },
    {
      "x": 2320,
      "y": 380,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-2",
      "type": "geo",
      "props": {
        "w": 460,
        "h": 230,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · THE WHOLE POINT — the only backward wire in this app. When “Clear and retry” SUCCEEDS, it loops back to re-run ComputePathToPose (up to Retry ×3) instead of merging forward like a Fallback arm"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a3c6E",
      "typeName": "shape"
    },
