        "outputs": [
          { "id": "out_1", "name": "pixels", "type": "Tensor", "visible": true }
        ]
      }
    },
    {
      "id": "sink",
      "type": "block",
      "x": 1000,
      "y": 210,
      "props": {
        "title": "encode()",
        "description": "The semantic cable exports as a stock solid elbow",
        "blockType": "Function",
        "view": "port",
        "w": 360,
        "h": 210,
        "inputs": [
          { "id": "in_1", "name": "pixels", "type": "Tensor", "visible": true }
