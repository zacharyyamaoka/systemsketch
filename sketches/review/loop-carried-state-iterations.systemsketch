        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The boundary port sits at the row it feeds, so the item cable is one short horizontal run and nothing crosses."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "b1Yq5fMV",
