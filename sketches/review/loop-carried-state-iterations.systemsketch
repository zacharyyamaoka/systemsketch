          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The z⁻¹ chip states both facts a delay has: one step late, and what arrives first."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
