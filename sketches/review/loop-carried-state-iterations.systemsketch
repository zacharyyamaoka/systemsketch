            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1 · Ten cards, top to bottom. Same Blocks and same cables every time — only the boundary port, the routing and the marks change."
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "b1beNz",
      "typeName": "shape"
    },
    {
      "x": 26,
