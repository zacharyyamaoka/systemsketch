                {
                  "type": "text",
                  "text": "1 · Right-click decode() → Detach to primitives"
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "It becomes stock tldraw shapes — geo, text, line — in ONE group. The cable becomes a plain arrow. Select it: the style panel is tldraw's own now."
                }
              ]
            }
          ]
        }
      },
