    {
      "x": 40,
      "y": 380,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-step-1",
      "type": "geo",
      "props": {
        "w": 500,
        "h": 220,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
