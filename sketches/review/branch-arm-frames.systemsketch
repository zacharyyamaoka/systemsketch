        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2 · Confirm divider clip() stops exactly at the else divider—none of its body or ports may enter else"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a32Xb",
