    {
      "x": 1410,
      "y": 620,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:cue-pass",
      "type": "geo",
      "props": {
        "w": 540,
        "h": 160,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "PASS WHEN · Every Block is visibly owned by one arm, overlapping the arm's own header is allowed, crossing into a neighboring arm is clipped, and fold/unfold still preserves the Blocks"
                }
              ]
            }
          ]
        }
      },
      "parentId": "page:page",
      "index": "a5zYUV",
      "typeName": "shape"
    },
    {
      "x": 1460,
      "y": 250,
      "rotation": 0,
      "isLocked": false,
